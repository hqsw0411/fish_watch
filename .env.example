FISHERIES_MODEL_RUNS_DIR=/srv/fish-watch-models/runs
FISHERIES_RESEARCH_DB=/srv/fish-watch-data/fisheries_forecast.sqlite3
FISHERIES_ALLOW_INDEX_BUILD=0
FISHERIES_HOST=127.0.0.1
FISHERIES_PORT=8000
